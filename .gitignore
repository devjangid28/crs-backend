# Dependencies
node_modules/

# Environment variables
# Ignore .env and EVERY .env.* variant (.env.backup, .env.tally-backup, ...).
# Those variants previously slipped past the plain `.env` rule and were
# committed with live credentials.
.env
.env.*
# .env.example is the sanitised template and must stay tracked
!.env.example

# Firebase service account keys - NEVER commit these
serviceAccountKey.json
*service-account*.json

# Build output
dist/
build/
release/
release_new/
release_new_empty/
win-unpacked/

# Logs
*.log
server_test.log
npm-debug.log*

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Database
*.db
*.sqlite
*.sql

# Migration 045 is the currently-active migration and must stay tracked, or a
# fresh clone cannot build the schema. Every other *.sql remains ignored.
!/src/migrations/045_whatsapp_outbox.sql

# Uploads (user-generated content)
uploads/*
!uploads/.gitkeep

# Coverage
coverage/

# System files
desktop.ini
